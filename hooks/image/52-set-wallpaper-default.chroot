#!/usr/bin/env bash
set -euo pipefail

OLPC_WALLPAPER_FILE="${OLPC_WALLPAPER_FILE:-OLPC_FICOHSA_BLUE.png}"
WALLPAPER_PICTURE_OPTIONS="${WALLPAPER_PICTURE_OPTIONS:-zoom}"
LOCAL_WALLPAPER_DIR="/usr/local/share/backgrounds/olpc-wallpaper"

SRC_FILE="${EIB_LOCALDATADIR}/wallpaper/${OLPC_WALLPAPER_FILE}"
DST_FILE="${LOCAL_WALLPAPER_DIR}/${OLPC_WALLPAPER_FILE}"
WALLPAPER="file://${DST_FILE}"

if [ ! -f "${SRC_FILE}" ]; then
    echo "No existe el archivo local: ${SRC_FILE}" >&2
    exit 1
fi

mkdir -p "${LOCAL_WALLPAPER_DIR}"
install -m 0644 "${SRC_FILE}" "${DST_FILE}"

mkdir -p /etc/dconf/profile
mkdir -p /etc/dconf/db/local.d

cat > /etc/dconf/profile/user <<EOF
user-db:user
system-db:local
EOF

cat > /etc/dconf/db/local.d/00-wallpaper <<EOF
[org/gnome/desktop/background]
picture-uri='${WALLPAPER}'
picture-uri-dark='${WALLPAPER}'
picture-options='${WALLPAPER_PICTURE_OPTIONS}'
EOF

dconf update